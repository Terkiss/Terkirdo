#!/usr/bin/env bash
# .agents/sync/post-merge
# Predictive Sync Post-merge Hook

set -e

# OS 환경 확인
OS_TYPE=$(uname -s)
if [[ "$OS_TYPE" == *"MINGW"* ]] || [[ "$OS_TYPE" == *"CYGWIN"* ]] || [[ "$OS_TYPE" == *"MSYS"* ]]; then
    IS_WINDOWS=true
else
    IS_WINDOWS=false
fi

IS_SQUASH=0
if [ "$1" = "1" ]; then
    IS_SQUASH=1
fi

CACHE_FILE=".terkirdo_pre_cache.md"
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id HEAD@{1} HEAD)

if [ -z "$CHANGED_FILES" ]; then
    exit 0
fi

CURRENT_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
MERGE_HASH="merge_$(head -c 8 /dev/urandom | xxd -p)"

cat <<EOF > "$CACHE_FILE"
---
sync_type: post-merge
timestamp: "$CURRENT_TIME"
os: "$OS_TYPE"
pending_id: "$MERGE_HASH"
status: "in_progress"
---
# Predictive Sync Context

\`\`\`json
{
  "event": "post-merge",
  "files": [
EOF

FIRST=true
while IFS= read -r file; do
    if [ "$FIRST" = true ]; then
        FIRST=false
    else
        echo "    ," >> "$CACHE_FILE"
    fi
    echo "    \"$file\"" >> "$CACHE_FILE"
done <<< "$CHANGED_FILES"

cat <<EOF >> "$CACHE_FILE"
  ]
}
\`\`\`
EOF

# 비동기 프로세스 호출
if [ "$IS_WINDOWS" = true ]; then
    start /b python .agents/sync/sync_engine.py --predictive --cache-file="$CACHE_FILE" > /dev/null 2>&1
else
    nohup python .agents/sync/sync_engine.py --predictive --cache-file="$CACHE_FILE" > /dev/null 2>&1 &
fi

exit 0
