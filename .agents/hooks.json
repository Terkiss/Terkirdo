{
  "terukirdo-safety-policy": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|notebook_edit|write_to_file|replace_file_content|multi_replace_file_content|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_use_policy.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "terukirdo-post-review": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|notebook_edit|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_tool_use_review.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "terukirdo-stop-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/stop_quality_gate.py",
        "timeout": 30
      }
    ]
  }
}
